APP_NAME=LegalMind API
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://legalmind:legalmind@localhost:5432/legalmind
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=15
UPLOAD_DIR=/app/data/uploads
PROCESSED_DIR=/app/data/processed
LOG_LEVEL=INFO
# Phase 2 retrieval models
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_FALLBACK_MODEL=sentence-transformers/all-distilroberta-v1
EMBEDDING_DIMENSION=768
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RETRIEVAL_CANDIDATES=50
RETRIEVAL_TOP_K=10
RRF_K=60
ENABLE_EMBEDDINGS=true

# Phase 3 RAG
LLM_PROVIDER=openai-compatible
# Set LLM_PROVIDER=openai-compatible and add a compatible API key to enable an external LLM.
LLM_API_KEY=your-provider-api-key
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60
MIN_EVIDENCE_COVERAGE=0.35
SUMMARY_MAP_LIMIT=8
ENABLE_FAITHFULNESS_JUDGE=true
FAITHFULNESS_JUDGE_MODEL=gpt-4o-mini

LEGAL_NER_MODEL=hf-tuner/BERT-Indian-legal-NER
LEGAL_NER_MAX_CHARS=12000
ENABLE_LEGAL_TRANSFORMER_NLP=true
LEGAL_NLP_VERSION=legal-transformer-ner-v1

# Phase 5
JURISDICTION=India - Supreme Court judgments
OCR_SUPPORTED=false
RATE_LIMIT_PER_MINUTE=60
ADMIN_API_KEY=change-me-admin
EVALUATOR_API_KEY=change-me-evaluator
AUTH_SECRET=change-me-long-random-auth-secret
AUTH_SESSION_TTL_SECONDS=28800
RETENTION_DAYS=0
REDIS_URL=redis://redis:6379/0
USE_WORKER=true
WORKER_QUEUE=legalmind
